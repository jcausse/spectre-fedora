[Unit]
Description=HP Spectre Audio Mute LED Hardware Sync
After=sound.target multi-user.target pipewire.service
Wants=sound.target

[Service]
Type=simple
User=root
Group=root
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="PULSE_SERVER=unix:/run/user/1000/pulse/native"
ExecStart=/usr/local/bin/audio-led-sync.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
